  "spawn_target": [],
  "surface_rule": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "condition",
        "if_true": {
          "type": "y_above",
          "anchor": {
            "absolute": 127
          },
          "surface_depth_multiplier": 0,
