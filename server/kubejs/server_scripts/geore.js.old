// create crushing
function createCrushing(event, item, result) {
    event.custom({
        "type": "create:crushing",
        "ingredients": [
            {
            "item": item
            }
        ],
        "processing_time": 350,
        "results": [
            {
            "id": result
            }
        ]
    });
}

// create milling
function createMilling(event, item, result, count) {
    event.custom({
        "type": "create:milling",
        "ingredients": [
            {
            "item": item
            }
        ],
        "processing_time": 50,
        "results": [
            {
            "count": count,
            "id": result
            }
        ]
    });
}

// mekanism crusher
function mekanismCrushing(event, item, result, count) {
    event.custom({
        "type":"mekanism:crushing",
        "input":
        {
            "count":1,
            "item": item
        },
        "output":
        {
            "count":count,
            "id": result
        }
    });
}

// oritech pulverizing
function oritechPulverizing(event, item, result, count) {
    event.custom({
        "type": "oritech:pulverizer",
        "ingredients": [
            {
            "item": item
            }
        ],
        "results": [
            {
            "count": count,
            "id": result
            }
        ],
        "time": 100
    });
}

// oritech fragmenting
function oritechFragmenting(event, item, result, count) {
    event.custom({
        "type": "oritech:grinder",
        "ingredients": [
            {
            "item": item
            }
        ],
        "results": [
            {
            "count": count,
            "id": result
            }
        ],
        "time": 40
    });
}

ServerEvents.recipes(event => {
    event.remove({ id: 'geore:redstone_from_smelting_redstone_shard' })
    event.remove({ id: 'geore:redstone_from_blasting_redstone_shard' })

    const georeRecipes = [
        { item: "geore:redstone_shard", result: "minecraft:redstone", count: 1 },
        { item: "geore:redstone_block", result: "geore:redstone_shard", count: 4 }
    ];

    georeRecipes.forEach(r => {
        // CREATE CRUSHING
        createCrushing(event, r.item, r.result);
        // CREATE MILLING
        createMilling(event, r.item, r.result, r.count);
        // MEKANISM CRUSHING
        mekanismCrushing(event, r.item, r.result, r.count);
        // ORITECH PULVERIZER
        oritechPulverizing(event, r.item, r.result, r.count);
        // ORITECH GRINDER
        oritechFragmenting(event, r.item, r.result, r.count);
    });

});